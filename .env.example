# Copy to .env and fill in TOKEN/KEY after the first boot.
#
#   1. Start the stack:   docker compose up -d --build
#   2. Open http://<server-ip>:8090 and create the admin account.
#   3. Click "Add System". In the dialog set:
#        Host = /beszel_socket/beszel.sock      (leave Port empty)
#      then copy the shown public key and token into KEY and TOKEN below.
#   4. Apply the credentials:   docker compose up -d
#
# The agent connects to the hub over the shared unix socket (beszel_socket),
# so no extra ports are exposed.

# How you reach the hub (used for dashboard links and the agent's WebSocket URL).
# Change to the public URL if accessing from another machine, e.g. http://192.168.1.10:8090
APP_URL=http://localhost:8090
HUB_URL=http://localhost:8090

# Filled in from the hub's "Add System" dialog (step 3):
TOKEN=
KEY=
